# Bijoy Bayanno key layout: source of truth for the generated key table.
#
# Grammar (one row per line; '#' starts a comment; fields are whitespace-separated):
#   <key> <layer> <kind> <source> <codepoint> [<codepoint> [<codepoint>]]
#
#   key       the character printed on the UNSHIFTED US key: a-z 0-9 ` - = [ ] \ ; ' , . /
#   layer     normal | shift | link | link-shift   (link = after the linker key 'g')
#   kind      consonant | final | link | vowel-sign | vowel-sign-pre | independent-vowel |
#             modifier | phala | reph | digit | punct
#   source    master    = verified on the MASTER reference: the Marks PC Solution Bijoy
#                         chart with its typing-rules table (designated master by the user,
#                         2026-10-06). The master wins over every other source.
#             chart     = not on the master, but printed on another Bijoy chart supplied by
#                         the user (the official "বিজয় বাংলা কীবোর্ড, তৃতীয় সংস্করণ" chart or a
#                         Unicode Bijoy chart) and contradicted by none.
#             This layout follows Bijoy only; no row comes from Avro or other layouts.
#             user-list = conjunct key sequences supplied by the user
#             memory    = engineer's recollection; NOT confirmed. Rejected by --strict
#                         (release) until confirmed against a reference.
#   codepoint U+XXXX, BMP only
#
# ড় ঢ় য় are stored as their single code points (U+09DC U+09DD U+09DF) to record letter
# identity. Whether output uses these or the NFC decomposed form is a backend setting
# (Phase 3), not a layout decision.

# --- Top letter row -----------------------------------------------------------------
q  normal  consonant          master  U+0999   # ঙ
q  shift   modifier           master  U+0982   # ং
w  normal  consonant          master  U+09AF   # য
w  shift   consonant          master  U+09DF   # য়
e  normal  consonant          master  U+09A1   # ড
e  shift   consonant          master  U+09A2   # ঢ
r  normal  consonant          master  U+09AA   # প
r  shift   consonant          master  U+09AB   # ফ
t  normal  consonant          master  U+099F   # ট
t  shift   consonant          master  U+09A0   # ঠ
y  normal  consonant          master  U+099A   # চ
y  shift   consonant          master  U+099B   # ছ
u  normal  consonant          master  U+099C   # জ
u  shift   consonant          master  U+099D   # ঝ
i  normal  consonant          master  U+09B9   # হ
i  shift   consonant          master  U+099E   # ঞ
o  normal  consonant          master  U+0997   # গ
o  shift   consonant          master  U+0998   # ঘ
p  normal  consonant          master  U+09DC   # ড়
p  shift   consonant          master  U+09DD   # ঢ়

# --- Home row -----------------------------------------------------------------------
a  normal      vowel-sign         master  U+09C3   # ৃ
a  shift       reph               master  U+09B0 U+09CD   # র্ (reph mark on the chart)
a  link        independent-vowel  master  U+098B   # ঋ
s  normal      vowel-sign         master  U+09C1   # ু
s  shift       vowel-sign         master  U+09C2   # ূ
s  link        independent-vowel  master  U+0989   # উ
s  link-shift  independent-vowel  master  U+098A   # ঊ
d  normal      vowel-sign-pre     master  U+09BF   # ি
d  shift       vowel-sign         master  U+09C0   # ী
d  link        independent-vowel  master  U+0987   # ই
d  link-shift  independent-vowel  master  U+0988   # ঈ
f  normal      vowel-sign         master  U+09BE   # া
f  shift       independent-vowel  master  U+0985   # অ
f  link        independent-vowel  master  U+0986   # আ
g  normal      link               master  U+09CD   # ্ (linker / hasant)
g  shift       punct              master  U+0964   # । (dari)
h  normal      consonant          master  U+09AC   # ব
h  shift       consonant          master  U+09AD   # ভ
j  normal      consonant          master  U+0995   # ক
j  shift       consonant          master  U+0996   # খ
k  normal      consonant          master  U+09A4   # ত
k  shift       consonant          master  U+09A5   # থ
l  normal      consonant          master  U+09A6   # দ
l  shift       consonant          master  U+09A7   # ধ
'  normal      punct              master  U+2019   # ’
'  shift       punct              master  U+201D   # ”
# ৎ / ঃ are on the backslash key (right of ']' on the 104-key charts).
\  normal      final              master  U+09CE   # ৎ
\  shift       modifier           master  U+0983   # ঃ

# --- Bottom letter row --------------------------------------------------------------
z  normal      phala              master  U+09CD U+09B0   # ্র (ra-phala)
z  shift       phala              master  U+09CD U+09AF   # ্য (ya-phala)
x  normal      independent-vowel  master  U+0993   # ও
x  shift       vowel-sign         master  U+09D7   # ৗ (au length mark; ে + ৗ = ৌ)
x  link-shift  independent-vowel  master  U+0994   # ঔ (G + Shift+X)
c  normal      vowel-sign-pre     master  U+09C7   # ে
c  shift       vowel-sign-pre     master  U+09C8   # ৈ
c  link        independent-vowel  master  U+098F   # এ
c  link-shift  independent-vowel  master  U+0990   # ঐ
v  normal      consonant          master  U+09B0   # র
v  shift       consonant          master  U+09B2   # ল
b  normal      consonant          master  U+09A8   # ন
b  shift       consonant          master  U+09A3   # ণ
n  normal      consonant          master  U+09B8   # স
n  shift       consonant          master  U+09B7   # ষ
m  normal      consonant          master  U+09AE   # ম
m  shift       consonant          master  U+09B6   # শ

# --- Number row ---------------------------------------------------------------------
`  normal  punct     master  U+2018   # ‘
`  shift   punct     master  U+201C   # “
1  normal  digit     master  U+09E7   # ১
2  normal  digit     master  U+09E8   # ২
3  normal  digit     master  U+09E9   # ৩
4  normal  digit     master  U+09EA   # ৪
5  normal  digit     master  U+09EB   # ৫
6  normal  digit     master  U+09EC   # ৬
7  normal  digit     master  U+09ED   # ৭
8  normal  digit     master  U+09EE   # ৮
9  normal  digit     master  U+09EF   # ৯
0  normal  digit     master  U+09E6   # ০
4  shift   punct     master  U+09F3   # ৳
7  shift   modifier  master  U+0981   # ঁ

# Intentionally unmapped (plain English on the master chart): Shift+6, , . / ; - = [ ]
# and their shifted forms.
# Unmapped keys pass through to the application unchanged.
